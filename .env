# Copy to .env and fill in before `docker compose up`.

# REQUIRED: JWT signing key. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=3b96489b168c5a7d218f82b8e6873cfba9f807b5bbc39dd42d356b9dc251e8c1

# Postgres password for the transit user (db service)
POSTGRES_PASSWORD=transit_pass

# Comma-separated CORS list applied by the API; the backend also serves the UI
# from the same origin, so "*" is fine while the UI is only served by the API.
# If you serve the UI elsewhere (Nginx/CDN), list that origin, e.g.
# https://transit.example.com
CORS_ORIGINS=*

# Host port for the API + UI
BACKEND_PORT=8000

# Set to 0 to skip demo seeding on first boot (empty DB => clean production start)
SEED_DEMO_DATA=1
